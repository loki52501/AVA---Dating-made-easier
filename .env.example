# ============================================================
# SpatialReal credentials (required for avatar)
# Get these from https://studio.spatialreal.ai -> API Keys
# ============================================================
SPATIALREAL_API_KEY=your_spatialreal_api_key
SPATIALREAL_APP_ID=your_app_id
SPATIALREAL_AVATAR_ID=your_avatar_id

# Console endpoint for session token generation.
# Adjust region if needed. Common values:
#   US West: https://console.us-west.spatialwalk.cloud/v1/console
#   CN:      https://console.cn.spatialwalk.cloud/v1/console
SPATIALREAL_CONSOLE_ENDPOINT=https://console.us-west.spatialwalk.cloud/v1/console

# ============================================================
# Cartesia TTS (primary voice output)
# Sign up at https://cartesia.ai -> free tier: 20K credits/month
# ============================================================
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238

# ============================================================
# LLM Provider (choose ONE — priority: DeepSeek > TokenRouter > OpenAI)
#
# Option A: DeepSeek (recommended — fast and cost-efficient)
#   Get from https://platform.deepseek.com -> API Keys
#
# Option B: OpenAI direct
#   Get from https://platform.openai.com/api-keys
#
# Option C: TokenRouter (intelligent LLM routing)
#   Sign up at https://tokenrouter.io
# ============================================================
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenAI (also used for TTS fallback if CARTESIA/ELEVENLABS not set)
OPENAI_API_KEY=your_openai_api_key

# TokenRouter (optional — overrides OpenAI for LLM only)
TOKENROUTER_API_KEY=your_tokenrouter_api_key
TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1

# LLM model override (optional — defaults: deepseek-chat / gpt-4o-mini)
# LLM_MODEL=deepseek-chat

# ============================================================
# STT Provider Selection (choose ONE)
#
# Option A: Cartesia Ink (recommended — unified with Cartesia TTS)
#   Uses the same Cartesia API key. No extra signup needed.
#   Set STT_PROVIDER=cartesia to use it.
#
# Option B: Bodhi ASR (Navana.ai)
#   Sign up at https://navana.ai -> get API key + Customer ID
#   Supports Indian languages: Hindi, Tamil, Kannada, etc.
# ============================================================
STT_PROVIDER=cartesia

# --- Cartesia Ink STT settings ---
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_STT_LANGUAGE=en
# CARTESIA_STT_MIN_VOLUME=0.1
# CARTESIA_STT_MAX_SILENCE=2.0

# --- Bodhi ASR settings (only needed if STT_PROVIDER=bodhi) ---
BODHI_API_KEY=your_bodhi_api_key
BODHI_CUSTOMER_ID=your_bodhi_customer_id
BODHI_MODEL=en-general-v2-8khz
BODHI_BASE_URL=https://bodhiagent.live

# ============================================================
# Client-side env vars (Vite requires VITE_ prefix)
# These are automatically exposed to the browser.
# Copy the same values from above.
# ============================================================
VITE_SPATIALREAL_APP_ID=your_app_id
VITE_SPATIALREAL_AVATAR_ID=your_avatar_id

# ============================================================
# LiveKit (optional — for room-based real-time voice)
# Sign up at https://livekit.io/cloud
# ============================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Server
# ============================================================
PORT=3001
